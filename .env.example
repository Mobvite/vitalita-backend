# Local MySQL for docker-compose.yml (development only).
# Copy this file to .env (git-ignored) and replace the placeholders. Never commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=vitalita
MYSQL_USER=vitalita
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Vitalita API settings (read by the API, NOT by docker compose).
# In development set them with dotnet user-secrets (see README); in production use these environment variables.
# Never commit real values.
# JWT signing secret, at least 32 bytes (e.g. openssl rand -base64 48).
Authentication__Jwt__Secret=
# Optional: first administrator, created on startup only when both are set.
Authentication__Admin__Email=
Authentication__Admin__Password=
